            dgvAppointments.DataSource = bindingSource;
            UpdateStatusCount();
        }

        private bool ValidateInputs(bool isUpdate = false)
        {
            bool isValid = true;
            errorProvider.Clear();

            if (string.IsNullOrWhiteSpace(txtId.Text))
            {
                errorProvider.SetError(txtId, "Mã lịch hẹn không được để trống.");
                isValid = false;
            }
            else if (!isUpdate && masterList.Any(x => x.Id.Equals(txtId.Text.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                errorProvider.SetError(txtId, "Mã lịch hẹn đã tồn tại. Vui lòng nhập mã duy nhất.");
                isValid = false;
            }

            if (string.IsNullOrWhiteSpace(txtName.Text))
            {
                errorProvider.SetError(txtName, "Tên bệnh nhân không được để trống.");
                isValid = false;
            }

            string phonePattern = @"^0\d{9,10}$";
            if (string.IsNullOrWhiteSpace(txtPhone.Text) || !Regex.IsMatch(txtPhone.Text.Trim(), phonePattern))
            {
                errorProvider.SetError(txtPhone, "Số điện thoại không hợp lệ (Phải bắt đầu bằng số 0 và có 10-11 chữ số).");
                isValid = false;
            }

            if (dtpAppointmentDate.Value < DateTime.Now)
            {
                errorProvider.SetError(dtpAppointmentDate, "Ngày giờ hẹn không được nằm trong quá khứ.");
                isValid = false;
            }

            if (cmbDoctor.SelectedIndex == -1)
            {
                errorProvider.SetError(cmbDoctor, "Vui lòng chọn bác sĩ khám.");
                isValid = false;
            }

            if (cmbStatus.SelectedIndex == -1)
            {
                errorProvider.SetError(cmbStatus, "Vui lòng chọn trạng thái.");
                isValid = false;
            }

            if (string.IsNullOrWhiteSpace(txtReason.Text))
            {
                errorProvider.SetError(txtReason, "Lý do khám không được để trống.");
                isValid = false;
            }

            return isValid;
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            if (!ValidateInputs(false)) return;

            var apt = new Appointment
            {
                Id = txtId.Text.Trim(),
                PatientName = txtName.Text.Trim(),
                Phone = txtPhone.Text.Trim(),
                AppointmentDate = dtpAppointmentDate.Value,
                Doctor = cmbDoctor.SelectedItem.ToString(),
                Reason = txtReason.Text.Trim(),
                Status = cmbStatus.SelectedItem.ToString()
            };

            masterList.Add(apt);
            ApplyFilter();
            ClearForm();
            MessageBox.Show("Thêm lịch hẹn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (dgvAppointments.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn lịch hẹn cần cập nhật trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateInputs(true)) return;

            var selectedApt = (Appointment)dgvAppointments.SelectedRows[0].DataBoundItem;

            selectedApt.PatientName = txtName.Text.Trim();
            selectedApt.Phone = txtPhone.Text.Trim();
            selectedApt.AppointmentDate = dtpAppointmentDate.Value;
            selectedApt.Doctor = cmbDoctor.SelectedItem.ToString();
            selectedApt.Reason = txtReason.Text.Trim();
            selectedApt.Status = cmbStatus.SelectedItem.ToString();

            bindingSource.ResetBindings(false);
            ApplyFilter();
            MessageBox.Show("Cập nhật lịch hẹn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnDelete_Click(object sender, EventArgs e)
        {
            if (dgvAppointments.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn lịch hẹn cần xóa trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var confirm = MessageBox.Show("Bạn có chắc chắn muốn xóa lịch hẹn này?", "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm == DialogResult.Yes)
            {
                var selectedApt = (Appointment)dgvAppointments.SelectedRows[0].DataBoundItem;
                masterList.Remove(selectedApt);
                ApplyFilter();
                ClearForm();
                MessageBox.Show("Đã xóa lịch hẹn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        private void BtnClear_Click(object sender, EventArgs e)
        {
            ClearForm();
        }

        private void ClearForm()
        {
            txtId.Clear();
            txtName.Clear();
            txtPhone.Clear();
            txtReason.Clear();
            dtpAppointmentDate.Value = DateTime.Now;
            if (cmbDoctor.Items.Count > 0) cmbDoctor.SelectedIndex = 0;
            if (cmbStatus.Items.Count > 0) cmbStatus.SelectedIndex = 0;
            txtId.Enabled = true;
            errorProvider.Clear();
            dgvAppointments.ClearSelection();
        }

        private void DgvAppointments_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                var apt = (Appointment)dgvAppointments.Rows[e.RowIndex].DataBoundItem;
                txtId.Text = apt.Id;
                txtId.Enabled = false; // Khóa không cho sửa Mã lịch hẹn khi đang cập nhật
                txtName.Text = apt.PatientName;
                txtPhone.Text = apt.Phone;
                dtpAppointmentDate.Value = apt.AppointmentDate;
                cmbDoctor.SelectedItem = apt.Doctor;
                txtReason.Text = apt.Reason;
                cmbStatus.SelectedItem = apt.Status;
                errorProvider.Clear();
            }
        }

        private void ApplyFilter()
        {
            string keyword = txtSearch.Text.Trim().ToLower();
            if (keyword == "tìm tên hoặc sđt...") keyword = "";

            string selectedStatus = cmbFilterStatus.SelectedIndex > 0 ? cmbFilterStatus.SelectedItem.ToString() : "Tất cả";
            bool filterDateEnabled = chkFilterDate.Checked;
            DateTime filterDate = dtpFilterDate.Value.Date;

            var filtered = masterList.Where(x =>
                (string.IsNullOrEmpty(keyword) || x.PatientName.ToLower().Contains(keyword) || x.Phone.Contains(keyword)) &&
                (selectedStatus == "Tất cả" || x.Status == selectedStatus) &&
                (!filterDateEnabled || x.AppointmentDate.Date == filterDate)
            ).ToList();

            displayList = new BindingList<Appointment>(filtered);
            bindingSource.DataSource = displayList;
            UpdateStatusCount();
        }

        private void UpdateStatusCount()
        {
            lblStatusCount.Text = $"Số lịch hẹn hiển thị: {bindingSource.Count}";
        }

        private void MenuExport_Click(object sender, EventArgs e)
        {
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*";
                sfd.FileName = $"LichHen_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

                if (sfd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        using (StreamWriter sw = new StreamWriter(sfd.FileName, false, System.Text.Encoding.UTF8))
                        {
                            sw.WriteLine("MaLichHen,HoTenBenhNhan,SoDienThoai,NgayGioHen,BacSi,LyDoKham,TrangThai");

                            foreach (var item in displayList)
                            {
                                sw.WriteLine($"\"{item.Id}\",\"{item.PatientName}\",\"{item.Phone}\",\"{item.AppointmentDate:dd/MM/yyyy HH:mm}\",\"{item.Doctor}\",\"{item.Reason}\",\"{item.Status}\"");
                            }
                        }
                        MessageBox.Show("Xuất file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi xuất file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }
