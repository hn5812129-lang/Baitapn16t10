                    }
                }
            }
        }

        private bool ValidateInputs(bool isUpdate = false)
        {
            bool isValid = true;
            errorProvider.Clear();

            // 1. Mã đơn
            if (string.IsNullOrWhiteSpace(txtOrderId.Text))
            {
                errorProvider.SetError(txtOrderId, "Mã đơn không được để trống.");
                isValid = false;
            }
            else if (!isUpdate && masterList.Any(x => x.OrderId.Equals(txtOrderId.Text.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                errorProvider.SetError(txtOrderId, "Mã đơn không được trùng.");
                isValid = false;
            }

            // 2. Tên khách hàng & SĐT
            if (string.IsNullOrWhiteSpace(txtCustomerName.Text))
            {
                errorProvider.SetError(txtCustomerName, "Tên khách hàng không được để trống.");
                isValid = false;
            }

            string phonePattern = @"^0\d{9,10}$";
            if (string.IsNullOrWhiteSpace(txtPhone.Text) || !Regex.IsMatch(txtPhone.Text.Trim(), phonePattern))
            {
                errorProvider.SetError(txtPhone, "Số điện thoại không hợp lệ (Phải bắt đầu bằng 0 và có 10-11 chữ số).");
                isValid = false;
            }

            // 3. Loại thiết bị & Trạng thái
            if (cmbEquipmentType.SelectedIndex == -1)
            {
                errorProvider.SetError(cmbEquipmentType, "Vui lòng chọn loại thiết bị.");
                isValid = false;
            }
            if (cmbStatus.SelectedIndex == -1)
            {
                errorProvider.SetError(cmbStatus, "Vui lòng chọn trạng thái.");
                isValid = false;
            }

            // 4. Mô tả lỗi bắt buộc
            if (string.IsNullOrWhiteSpace(txtErrorDescription.Text))
            {
                errorProvider.SetError(txtErrorDescription, "Mô tả lỗi bắt buộc phải nhập.");
                isValid = false;
            }

            // 5. Chi phí dự kiến không âm
            if (numEstimatedCost.Value < 0)
            {
                errorProvider.SetError(numEstimatedCost, "Chi phí dự kiến phải là số không âm.");
                isValid = false;
            }

            return isValid;
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            if (!ValidateInputs(false)) return;

            var order = new RepairOrder
            {
                OrderId = txtOrderId.Text.Trim(),
                CustomerName = txtCustomerName.Text.Trim(),
                Phone = txtPhone.Text.Trim(),
                EquipmentType = cmbEquipmentType.SelectedItem.ToString(),
                ErrorDescription = txtErrorDescription.Text.Trim(),
                ReceiveDate = dtpReceiveDate.Value.Date,
                EstimatedCost = numEstimatedCost.Value,
                Status = cmbStatus.SelectedItem.ToString(),
                ImagePath = currentImagePath
            };

            masterList.Add(order);
            ApplyFilter();
            ClearForm();
            MessageBox.Show("Thêm đơn sửa chữa thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (dgvOrders.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn đơn sửa chữa cần cập nhật trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateInputs(true)) return;

            var selected = (RepairOrder)dgvOrders.SelectedRows[0].DataBoundItem;

            selected.CustomerName = txtCustomerName.Text.Trim();
            selected.Phone = txtPhone.Text.Trim();
            selected.EquipmentType = cmbEquipmentType.SelectedItem.ToString();
            selected.ErrorDescription = txtErrorDescription.Text.Trim();
            selected.ReceiveDate = dtpReceiveDate.Value.Date;
            selected.EstimatedCost = numEstimatedCost.Value;
            selected.Status = cmbStatus.SelectedItem.ToString();
            selected.ImagePath = currentImagePath;

            bindingSource.ResetBindings(false);
            ApplyFilter();
            MessageBox.Show("Cập nhật đơn sửa chữa thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnDelete_Click(object sender, EventArgs e)
        {
            if (dgvOrders.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn đơn sửa chữa cần xóa trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var confirm = MessageBox.Show("Bạn có chắc chắn muốn xóa đơn sửa chữa này?", "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm == DialogResult.Yes)
            {
                var selected = (RepairOrder)dgvOrders.SelectedRows[0].DataBoundItem;
                masterList.Remove(selected);
                ApplyFilter();
                ClearForm();
                MessageBox.Show("Đã xóa đơn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        private void BtnClear_Click(object sender, EventArgs e)
        {
            ClearForm();
        }

        private void ClearForm()
        {
            txtOrderId.Clear();
            txtCustomerName.Clear();
            txtPhone.Clear();
            txtErrorDescription.Clear();
            numEstimatedCost.Value = 0;
            if (cmbEquipmentType.Items.Count > 0) cmbEquipmentType.SelectedIndex = 0;
            if (cmbStatus.Items.Count > 0) cmbStatus.SelectedIndex = 0;
            dtpReceiveDate.Value = DateTime.Now;
            txtOrderId.Enabled = true;
            currentImagePath = string.Empty;
            picEquipment.Image = null;
            errorProvider.Clear();
            dgvOrders.ClearSelection();
        }

        private void DgvOrders_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                var order = (RepairOrder)dgvOrders.Rows[e.RowIndex].DataBoundItem;
                txtOrderId.Text = order.OrderId;
                txtOrderId.Enabled = false; // Khóa mã đơn khi cập nhật
                txtCustomerName.Text = order.CustomerName;
                txtPhone.Text = order.Phone;
                cmbEquipmentType.SelectedItem = order.EquipmentType;
                txtErrorDescription.Text = order.ErrorDescription;
                dtpReceiveDate.Value = order.ReceiveDate;
                numEstimatedCost.Value = order.EstimatedCost;
                cmbStatus.SelectedItem = order.Status;

                currentImagePath = order.ImagePath;
                if (!string.IsNullOrEmpty(currentImagePath) && File.Exists(currentImagePath))
                {
                    try
                    {
                        picEquipment.Image = Image.FromFile(currentImagePath);
                    }
                    catch
                    {
                        picEquipment.Image = null;
                    }
                }
                else
                {
                    picEquipment.Image = null;
                }

                errorProvider.Clear();
            }
        }

        private void ApplyFilter()
        {
            string keyword = txtSearch.Text.Trim().ToLower();
            if (keyword == "mã đơn, tên kh hoặc sđt...") keyword = "";

            string statusFilter = cmbFilterStatus.SelectedIndex > 0 ? cmbFilterStatus.SelectedItem.ToString() : "Tất cả";

            var filtered = masterList.Where(x =>
                (string.IsNullOrEmpty(keyword) || x.OrderId.ToLower().Contains(keyword) || x.CustomerName.ToLower().Contains(keyword) || x.Phone.Contains(keyword)) &&
                (statusFilter == "Tất cả" || x.Status == statusFilter)
            ).ToList();

            displayList = new BindingList<RepairOrder>(filtered);
            bindingSource.DataSource = displayList;
            UpdateStatusStrip();
        }

        private void UpdateStatusStrip()
        {
            int totalCount = bindingSource.Count;

            // Tính tổng chi phí dự kiến của các đơn CHƯA HOÀN TẤT (Trạng thái khác "Hoàn tất" và "Đã hủy")
            decimal totalCostUnfinished = displayList
                .Where(x => x.Status != "Hoàn tất" && x.Status != "Đã hủy")
                .Sum(x => x.EstimatedCost);

            lblCountInfo.Text = $"Số đơn hiển thị: {totalCount}  |  ";
            lblTotalCostInfo.Text = $"Tổng chi phí dự kiến (chưa hoàn tất): {totalCostUnfinished:N0} ₫";
        }

        private void MenuExport_Click(object sender, EventArgs e)
        {
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*";
                sfd.FileName = $"DonSuaChua_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

                if (sfd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        using (StreamWriter sw = new StreamWriter(sfd.FileName, false, System.Text.Encoding.UTF8))
                        {
                            sw.WriteLine("MaDon,TenKhachHang,SoDienThoai,LoaiThietBi,MoTaLoi,NgayTiepNhan,ChiPhiDuKien,TrangThai");

                            foreach (var item in displayList)
                            {
                                sw.WriteLine($"\"{item.OrderId}\",\"{item.CustomerName}\",\"{item.Phone}\",\"{item.EquipmentType}\",\"{item.ErrorDescription}\",\"{item.ReceiveDate:dd/MM/yyyy}\",{item.EstimatedCost},\"{item.Status}\"");
                            }
                        }
                        MessageBox.Show("Xuất danh sách ra file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi xuất file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }
