        private void ClearForm()
        {
            txtTicketId.Clear();
            txtStudentId.Clear();
            txtStudentName.Clear();
            numQuantity.Value = 1;
            if (cmbEquipment.Items.Count > 0) cmbEquipment.SelectedIndex = 0;
            dtpCheckoutDate.Value = DateTime.Now;
            dtpDueDate.Value = DateTime.Now.AddDays(7);
            chkIsReturned.Checked = false;
            dtpReturnDate.Value = DateTime.Now;
            dtpReturnDate.Enabled = false;
            txtTicketId.Enabled = true;
            errorProvider.Clear();
            dgvCheckout.ClearSelection();
        }

        private void DgvCheckout_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0)
            {
                var record = (CheckoutRecord)dgvCheckout.Rows[e.RowIndex].DataBoundItem;
                txtTicketId.Text = record.TicketId;
                txtTicketId.Enabled = false; // Khóa mã phiếu khi cập nhật
                txtStudentId.Text = record.StudentId;
                txtStudentName.Text = record.StudentName;
                cmbEquipment.SelectedItem = record.EquipmentName;
                numQuantity.Value = record.Quantity;
                dtpCheckoutDate.Value = record.CheckoutDate;
                dtpDueDate.Value = record.DueDate;

                if (record.ReturnDate.HasValue)
                {
                    chkIsReturned.Checked = true;
                    dtpReturnDate.Enabled = true;
                    dtpReturnDate.Value = record.ReturnDate.Value;
                }
                else
                {
                    chkIsReturned.Checked = false;
                    dtpReturnDate.Enabled = false;
                    dtpReturnDate.Value = DateTime.Now;
                }

                errorProvider.Clear();
            }
        }

        private void ApplyFilter()
        {
            string keyword = txtSearch.Text.Trim().ToLower();
            if (keyword == "mã sv hoặc tên thiết bị...") keyword = "";

            string statusFilter = cmbFilterStatus.SelectedIndex > 0 ? cmbFilterStatus.SelectedItem.ToString() : "Tất cả";
            bool dateFilterEnabled = chkFilterDate.Checked;
            DateTime filterDate = dtpFilterDate.Value.Date;

            var filtered = masterList.Where(x =>
                (string.IsNullOrEmpty(keyword) || x.StudentId.ToLower().Contains(keyword) || x.EquipmentName.ToLower().Contains(keyword)) &&
                (statusFilter == "Tất cả trạng thái" || x.Status == statusFilter) &&
                (!dateFilterEnabled || x.CheckoutDate.Date == filterDate)
            ).ToList();

            displayList = new BindingList<CheckoutRecord>(filtered);
            bindingSource.DataSource = displayList;
            UpdateStatusStrip();
        }

        private void UpdateStatusStrip()
        {
            int total = bindingSource.Count;
            // Đếm số phiếu quá hạn trong danh sách đang hiển thị
            int overdue = displayList.Count(x => x.Status == "Quá hạn");
            lblTotalCount.Text = $"Tổng số phiếu: {total}  |  ";
            lblOverdueCount.Text = $"Số phiếu quá hạn: {overdue}";
        }

        private void MenuExport_Click(object sender, EventArgs e)
        {
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.Filter = "CSV files (*.csv)|*.csv|All files (*.*)|*.*";
                sfd.FileName = $"PhieuMuonThietBi_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

                if (sfd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        using (StreamWriter sw = new StreamWriter(sfd.FileName, false, System.Text.Encoding.UTF8))
                        {
                            sw.WriteLine("MaPhiếu,MaSV,HoTenSinhVien,ThietBi,SoLuong,NgayMuon,HanTra,NgayTraThucTe,TrangThai");

                            foreach (var item in displayList)
                            {
                                string retDateStr = item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("dd/MM/yyyy") : "";
                                sw.WriteLine($"\"{item.TicketId}\",\"{item.StudentId}\",\"{item.StudentName}\",\"{item.EquipmentName}\",{item.Quantity},\"{item.CheckoutDate:dd/MM/yyyy}\",\"{item.DueDate:dd/MM/yyyy}\",\"{retDateStr}\",\"{item.Status}\"");
                            }
                        }
                        MessageBox.Show("Xuất danh sách đang lọc ra file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi xuất file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }
