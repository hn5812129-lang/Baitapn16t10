    public class CheckoutRecord
    {
        public string TicketId { get; set; }        // Mã phiếu (Duy nhất)
        public string StudentId { get; set; }       // Mã sinh viên
        public string StudentName { get; set; }     // Họ tên sinh viên
        public string EquipmentName { get; set; }   // Tên thiết bị
        public int Quantity { get; set; }           // Số lượng
        public DateTime CheckoutDate { get; set; }  // Ngày mượn
        public DateTime DueDate { get; set; }       // Hạn trả
        public DateTime? ReturnDate { get; set; }   // Ngày trả thực tế (nullable)

        // Trạng thái tự động tính toán dựa trên điều kiện thực tế
        public string Status
        {
            get
            {
                if (ReturnDate.HasValue) return "Đã trả";
                if (DueDate.Date < DateTime.Now.Date) return "Quá hạn";
                return "Đang mượn";
            }
        }
    }

