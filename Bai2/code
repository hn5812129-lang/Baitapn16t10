        private bool ValidateInputs(bool isUpdate = false)
        {
            bool isValid = true;
            errorProvider.Clear();

            // 1. Mã phiếu
            if (string.IsNullOrWhiteSpace(txtTicketId.Text))
            {
                errorProvider.SetError(txtTicketId, "Mã phiếu không được để trống.");
                isValid = false;
            }
            else if (!isUpdate && masterList.Any(x => x.TicketId.Equals(txtTicketId.Text.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                errorProvider.SetError(txtTicketId, "Mã phiếu không được trùng.");
                isValid = false;
            }

            // 2. Mã sinh viên & Họ tên
            if (string.IsNullOrWhiteSpace(txtStudentId.Text))
            {
                errorProvider.SetError(txtStudentId, "Mã sinh viên không được để trống.");
                isValid = false;
            }
            if (string.IsNullOrWhiteSpace(txtStudentName.Text))
            {
                errorProvider.SetError(txtStudentName, "Họ tên sinh viên không được để trống.");
                isValid = false;
            }

            // 3. Thiết bị
            if (cmbEquipment.SelectedIndex == -1)
            {
                errorProvider.SetError(cmbEquipment, "Vui lòng chọn thiết bị.");
                isValid = false;
            }

            // 4. Số lượng > 0
            if (numQuantity.Value <= 0)
            {
                errorProvider.SetError(numQuantity, "Số lượng phải lớn hơn 0.");
                isValid = false;
            }

            // 5. Hạn trả không trước ngày mượn
            if (dtpDueDate.Value.Date < dtpCheckoutDate.Value.Date)
            {
                errorProvider.SetError(dtpDueDate, "Hạn trả không được trước ngày mượn.");
                isValid = false;
            }

            // 6. Ngày trả thực tế không trước ngày mượn (nếu chọn đã trả)
            if (chkIsReturned.Checked && dtpReturnDate.Value.Date < dtpCheckoutDate.Value.Date)
            {
                errorProvider.SetError(dtpReturnDate, "Ngày trả thực tế không được trước ngày mượn.");
                isValid = false;
            }

            return isValid;
        }

        private void BtnAdd_Click(object sender, EventArgs e)
        {
            if (!ValidateInputs(false)) return;

            var record = new CheckoutRecord
            {
                TicketId = txtTicketId.Text.Trim(),
                StudentId = txtStudentId.Text.Trim(),
                StudentName = txtStudentName.Text.Trim(),
                EquipmentName = cmbEquipment.SelectedItem.ToString(),
                Quantity = (int)numQuantity.Value,
                CheckoutDate = dtpCheckoutDate.Value.Date,
                DueDate = dtpDueDate.Value.Date,
                ReturnDate = chkIsReturned.Checked ? (DateTime?)dtpReturnDate.Value.Date : null
            };

            masterList.Add(record);
            ApplyFilter();
            ClearForm();
            MessageBox.Show("Thêm phiếu mượn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnUpdate_Click(object sender, EventArgs e)
        {
            if (dgvCheckout.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn phiếu mượn cần cập nhật trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (!ValidateInputs(true)) return;

            var selected = (CheckoutRecord)dgvCheckout.SelectedRows[0].DataBoundItem;

            selected.StudentId = txtStudentId.Text.Trim();
            selected.StudentName = txtStudentName.Text.Trim();
            selected.EquipmentName = cmbEquipment.SelectedItem.ToString();
            selected.Quantity = (int)numQuantity.Value;
            selected.CheckoutDate = dtpCheckoutDate.Value.Date;
            selected.DueDate = dtpDueDate.Value.Date;
            selected.ReturnDate = chkIsReturned.Checked ? (DateTime?)dtpReturnDate.Value.Date : null;

            bindingSource.ResetBindings(false);
            ApplyFilter();
            MessageBox.Show("Cập nhật phiếu mượn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void BtnDelete_Click(object sender, EventArgs e)
        {
            if (dgvCheckout.SelectedRows.Count == 0)
            {
                MessageBox.Show("Vui lòng chọn phiếu mượn cần xóa trên bảng.", "Cảnh báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var confirm = MessageBox.Show("Bạn có chắc chắn muốn xóa phiếu mượn này?", "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (confirm == DialogResult.Yes)
            {
                var selected = (CheckoutRecord)dgvCheckout.SelectedRows[0].DataBoundItem;
                masterList.Remove(selected);
                ApplyFilter();
                ClearForm();
                MessageBox.Show("Đã xóa phiếu mượn thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

